    "workflow": {
      "format": "method/3.1",
      "name": "Portable ledger",
      "goal": "Read a bound folder and record one checked update.",
      "inputs": {
        "pause": {
          "type": "boolean",
          "default": false
        }
      },
      "state": {
        "count": {
          "type": "number",
          "default": 0
        }
      },
      "environment": {
        "records": {
          "type": "files",
          "description": "Folder with message.txt and a test ledger."
        }
      },
      "steps": {
        "write": {
          "in": {
            "folder": "environment.records",
            "count": "state.count"
          },
          "do": {
            "kind": "run",
            "runtime": "node",
            "entrypoint": "write.mjs"
          },
          "out": {
            "text": {
              "type": "text"
            }
          },
          "changes": [
            "state.count",
            "environment.records"
          ],
          "check": {
            "kind": "run",
            "runtime": "node",
            "entrypoint": "check.mjs"
          }
        },
        "confirm": {
          "after": "write",
          "when": "inputs.pause",
          "ask": "Continue?",
          "out": {
            "answer": {
              "type": "text"
            }
          }
        }
      },
      "result": "text"
    },
